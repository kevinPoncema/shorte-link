# Server Runtime (Backend API)
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Frontend Client
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# OpenAPI / Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# PostgreSQL (Control Plane)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=qr_shortener
DB_SYNCHRONIZE=true
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

# Redis (Data Plane & Analytics Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & Security
JWT_SECRET=change-this-super-secret-jwt-key-in-production
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10
IP_HASH_SALT=change-this-ip-anonymization-salt
CORS_ORIGIN=*
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Analytics Background Worker (Redis RAM to PostgreSQL Batch Ingestion)
ANALYTICS_WORKER_ENABLED=true
ANALYTICS_WORKER_INTERVAL_MS=15000
ANALYTICS_WORKER_BATCH_SIZE=200

# GeoIP & Cloudflare/Nginx Proxy Country Resolution
DEV_GEOIP_FALLBACK_COUNTRY=HN

# Stripe Keys
STRIPE_SECRET_KEY=sk_test_51MockStripeSecretKeyForLocalDev1234567890
STRIPE_WEBHOOK_SECRET=whsec_MockStripeWebhookSecret1234567890
STRIPE_PRO_PRICE_ID=price_1ProMonthlySubscriptionMock123456

# Feature Flags
ENABLE_PHYSICAL_ORDERS=true

# Precios Base para Hardware Físico con NFC (USD)
PRICE_ACRYLIC_STAND=15.00
PRICE_PLASTIC_CARD=10.00
PRICE_NFC_CARD=10.00
PRICE_NFC_STICKER=5.00

